{
  "name": "sifcas",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "dev": "next dev",
    "audit:ui": "node scripts/audit-interactions.mjs",
    "audit:routes": "node scripts/audit-routes.mjs",
    "audit": "npm run audit:ui && npm run audit:routes && npm run audit:quality",
    "build": "npm run audit && npm test && next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm test && npm run audit",
    "audit:quality": "node scripts/audit-quality.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "lucide-react": "^0.468.0",
    "next": "16.3.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.4",
    "typescript": "^5.7.0"
  }
}
