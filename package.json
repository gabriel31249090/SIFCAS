{
  "name": "sifcas",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "audit:ui": "node scripts/audit-interactions.mjs",
    "audit:routes": "node scripts/audit-routes.mjs",
    "audit": "npm run audit:ui && npm run audit:routes && npm run audit:quality",
    "build": "npm run audit && npm test && next build",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "db:backup": "node scripts/backup-supabase.mjs",
    "db:restore-test": "node scripts/restore-supabase-test.mjs",
    "supabase:link": "supabase link --project-ref xqhilujzacwebeexljaf",
    "supabase:pull": "supabase db pull remote_schema --linked",
    "supabase:lint": "supabase db lint --linked --level warning --fail-on error",
    "supabase:types": "node scripts/generate-supabase-types.mjs",
    "supabase:email-config": "node scripts/sync-supabase-email-templates.mjs",
    "supabase:email-apply": "node scripts/sync-supabase-email-templates.mjs --apply",
    "start": "next start",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm test && npm run audit",
    "audit:quality": "node scripts/audit-quality.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "lucide-react": "^0.468.0",
    "next": "16.3.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.4",
    "supabase": "2.117.0",
    "typescript": "^5.7.0"
  }
}
