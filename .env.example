# Copie para .env.local. Nunca use o banco de produção no desenvolvimento.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Cole a chave anon/publicável emitida pelo SEU Supabase local ou de homologação.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Ative apenas após validar o contrato SQL em homologação (ver docs/integracoes-ifmt.md).
SIFCAS_ACADEMIC_IMPORT_ENABLED=false
SIFCAS_PERSONAL_CALENDAR_ENABLED=false

# Operação opcional, sempre no servidor e nunca em variáveis NEXT_PUBLIC_.
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_DB_URL=
# SIFCAS_RESTORE_TEST_DB_URL=
# SIFCAS_CONFIRM_RESTORE_TEST=RESTORE_SIFCAS_TEST_ONLY
