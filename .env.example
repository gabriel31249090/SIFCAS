# Use the URL and publishable key from the same local or staging Supabase project.
# Leave these blank until that project is provisioned.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Enable only after the isolated schema, RLS, mappings, and retention are approved.
SIFCAS_ACADEMIC_IMPORT_ENABLED=false
SIFCAS_PERSONAL_CALENDAR_ENABLED=false

# SIFCAS Mail — manter todos os segredos apenas no servidor/Vercel, nunca NEXT_PUBLIC_.
# Ainda exige aprovação institucional, credenciais OAuth e migração SQL revisada.
SUPABASE_SERVICE_ROLE_KEY=
SIFCAS_MAIL_PUBLIC_URL=https://sifcas.vercel.app
SIFCAS_MAIL_GOOGLE_CLIENT_ID=
SIFCAS_MAIL_GOOGLE_CLIENT_SECRET=
# Gerar com: openssl rand -base64 32 (pode conter /, + e =; o sistema aceita base64url também)
SIFCAS_MAIL_TOKEN_KEY=
# Gerar uma string aleatória longa e exclusiva para autenticar o cron.
CRON_SECRET=
# Automação DESLIGADA até aprovação/conta do sistema conectada.
SIFCAS_MAIL_AUTOMATIC_ASSESSMENTS=false
SIFCAS_MAIL_SYSTEM_SENDER_USER_ID=
