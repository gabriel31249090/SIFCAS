{
  "name": "sifcas-ui-auditor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "audit": "node --experimental-strip-types src/index.ts",
    "audit:lighthouse": "node --experimental-strip-types src/lighthouse.ts",
    "audit:production": "node --experimental-strip-types src/production-performance.ts",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "axe-core": "4.10.3",
    "chrome-launcher": "1.2.3",
    "lighthouse": "13.6.0",
    "playwright": "1.56.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
